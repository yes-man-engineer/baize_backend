# 服务
APP_ENV=dev
APP_PORT=8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 用强随机密码，别用 root / baize123 这种。生成一个：
#   openssl rand -hex 16
# 这个项目 2026-07-16 因为弱密码 + 3306 暴露公网被扫库删库过。
DB_PASSWORD=
DB_NAME=startup_copilot

# docker compose 建库时用，和上面保持一致或另给一个强随机值
MYSQL_ROOT_PASSWORD=

# 大模型（OpenAI 兼容接口）
# DeepSeek: https://api.deepseek.com/v1        模型 deepseek-chat
# Kimi:     https://api.moonshot.cn/v1         模型 moonshot-v1-8k
# 通义:      https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120

# 跨域白名单，逗号分隔。留空=放开全部（只该在本地开发用）
# 上域名前务必填上，如 CORS_ORIGINS=https://baize.com,https://www.baize.com
# 前端由 nginx 同源反代的话可以不填
CORS_ORIGINS=
